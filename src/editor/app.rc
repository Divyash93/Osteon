BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Osteon 2D skeletal animation editor"
      VALUE "ProductName", "Osteon"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductVersion", "0.1.0"
      VALUE "OriginalFilename", "Osteon.exe"
    END
  END
  BLOCK "VarFileInfo"
